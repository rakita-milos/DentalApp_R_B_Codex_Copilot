# Keep this file as a template only. Put real values in backend/.env (gitignored).
TURSO_DATABASE_URL=libsql://your-database-your-org.aws-region.turso.io
TURSO_AUTH_TOKEN=replace-with-a-database-token

# Private S3-compatible object storage. Cloudflare R2 works with these values.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=drrosa-private
S3_ACCESS_KEY_ID=replace-with-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-secret-access-key
